# Copy to .env and fill in. Never commit the real .env file.

PORT=3000

# Comma-separated list of origins allowed to call the API (the website's URL).
# Production: CORS_ORIGINS=https://krunazaveta.com,https://www.krunazaveta.com
CORS_ORIGINS=http://localhost:4200

# Set to the number of reverse proxies in front of the app (e.g. 1 behind nginx),
# so rate limiting sees the real client IP. 0 when exposed directly.
TRUST_PROXY=0

# SMTP server used to send email. Leave SMTP_HOST empty in development:
# emails are then printed to the console instead of being sent.
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (implicit TLS), false for 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Sender address (must be allowed by your SMTP provider) and the inbox that receives contact messages.
MAIL_FROM="Kruna Zaveta <no-reply@krunazaveta.com>"
CONTACT_RECIPIENT=info@krunazaveta.com

# Cloudflare Turnstile captcha for the contact form (https://dash.cloudflare.com → Turnstile → Add widget,
# hostname krunazaveta.com). The value below is Cloudflare's TEST secret that accepts everything – local use only.
# The matching site key goes into kruna-zaveta-frontend/src/environments/environment.ts.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Messages one IP address may send per day.
DAILY_MESSAGE_LIMIT=3

# Send an automatic "we received your message" reply to the sender (true/false).
SEND_CONFIRMATION=false

# News editor login (Decap CMS at https://krunazaveta.com/admin). Leave GITHUB_CLIENT_ID empty to disable.
# Create a GitHub OAuth App (GitHub → Settings → Developer settings → OAuth Apps):
#   Homepage URL:               https://krunazaveta.com
#   Authorization callback URL: https://krunazaveta.com/api/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# The website origin allowed to receive the login token.
CMS_SITE_ORIGIN=https://krunazaveta.com
# Comma-separated email addresses allowed to log in to the editor. Each must be a VERIFIED email
# of the person's GitHub account (GitHub → Settings → Emails). Everyone else is refused.
ADMIN_EMAILS=
